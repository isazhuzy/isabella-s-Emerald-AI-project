# ---- Claude (Anthropic) ----
ANTHROPIC_API_KEY=sk-ant-...
# Set this to a current model id you have access to (e.g. an Opus or Sonnet variant).
EMERALD_MODEL=claude-sonnet-4-5

# ---- Web UI (server.py) ----
# Password for the browser UI login (any username, this password). Default: emerald
EMERALD_UI_PASSWORD=emerald

# ---- Fireflies.ai live transcription (server.py webhook) ----
# API key: Fireflies -> Settings -> Developer Settings. Used to fetch the transcript.
FIREFLIES_API_KEY=
# Webhook secret (16-32 chars) you set in Fireflies Developer Settings; verifies the
# x-hub-signature on incoming webhooks. Leave blank to skip verification (dev only).
FIREFLIES_WEBHOOK_SECRET=
# Name intake calls "Intake — <Client>" so the client is auto-derived + anonymized.
# Set to true to have the webhook auto-create the (unpublished) Loxo job. The
# generated JD lands in the job's Description tab as clean HTML:
EMERALD_WEBHOOK_PUSH=false
# Set to true to also source candidates on each transcript and store the fetched list
# under output/candidates/<job>.json. Needs SEAMLESS_API_KEY (else degrades to mock):
EMERALD_WEBHOOK_SOURCE=false
# Set to true to also gather contacts (email/phone) for the sourced candidates and
# store them with the list. Spends Seamless credits (capped at EMERALD_ENRICH_TOP_N);
# requires EMERALD_WEBHOOK_SOURCE=true:
EMERALD_WEBHOOK_ENRICH=false
# Set to true to PUBLISH webhook-created jobs live (Loxo careers page + organic boards
# like Google Jobs). OFF by default — publishing is public and hard to reverse. NOTE:
# the Open API only exposes the careers-page publish flag; syndication to specific paid
# boards (Indeed Sponsored, LinkedIn, ZipRecruiter) is configured in the Loxo UI, not here:
EMERALD_WEBHOOK_PUBLISH=false

# ---- Seamless.AI (candidate sourcing / enrichment — API is an Enterprise feature) ----
# Used by `run.py --source`. Auth is a `Token:` header. Leave blank to skip sourcing.
SEAMLESS_API_KEY=

# ---- SalesQL (secondary contact enrichment — FALLBACK) ----
# Backfills email/phone that Seamless couldn't find, by LinkedIn URL. Paid plan w/ API.
SALESQL_API_KEY=
# Which enrichment provider(s): "seamless" (default), "salesql", or "both". "both"/
# "salesql" turn on the SalesQL fallback (only fires when SALESQL_API_KEY is set).
EMERALD_ENRICH_PROVIDER=seamless

# ---- Loxo Open API (paid feature) ----
# Get these from Loxo: Settings > API Keys (admin only) for the token;
# contact Loxo Support for your agency domain + slug.
LOXO_DOMAIN=youragency.app.loxo.co
LOXO_SLUG=your-agency-slug
LOXO_API_KEY=your-bearer-token

# Loxo REQUIRES these on job creation. Fetch valid IDs first:
#   GET /api/{slug}/job_types
#   GET /api/{slug}/companies   (or create the company assignment)
LOXO_DEFAULT_JOB_TYPE_ID=
LOXO_DEFAULT_COMPANY_ID=

# ---- B1 (Loxo-native sourcing) — see LOXO_SETUP.md ----
# Optional: owner for created records / activities.
LOXO_DEFAULT_OWNER_ID=
# Job "belongs to" — Loxo login email(s) of the job owner(s), comma-separated.
# Set this so every pushed job auto-belongs to that recruiter (job[owner_emails][]).
LOXO_DEFAULT_OWNER_EMAILS=
# Activity type id used to post the Sourcing Brief as a job note.
# Discover via: python -c "from emerald.loxo import LoxoClient; print(LoxoClient().activity_types())"
# Leave blank to skip posting the note on --push.
LOXO_NOTE_ACTIVITY_TYPE_ID=
# These names MUST match the stages/campaign in your Loxo workflow (LOXO_SETUP.md).
# Defaults below match the live Emerald Resource Group workflow:
#   Long List  = the full 75-150 long list (no enrichment, free)
#   Short List = the top 15-20 shortlist (enrichment + outreach fire here)
LOXO_SOURCING_STAGE_NAME=Long List
LOXO_OUTREACH_STAGE_NAME=Short List
LOXO_OUTREACH_CAMPAIGN_NAME=Confidential Outreach
# Enrichment cost-control: only this many move to the Outreach stage.
EMERALD_ENRICH_TOP_N=20
# Size of the sourced long list per role (spec target: 75-150). We over-fetch and
# drop obvious mismatches, so the delivered count lands at or just under this.
EMERALD_SOURCE_LIMIT=150
